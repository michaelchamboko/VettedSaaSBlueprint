{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "result=0; for check in typecheck lint test validate:public-site build; do npm run \"$check\"; status=$?; echo \"VALIDATION $check $status\"; [ \"$status\" -eq 0 ] || result=1; done; exit \"$result\"",
  "installCommand": "npx --yes npm@12.0.2 ci",
  "regions": [
    "cpt1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
