{
  "schema_version": 2,
  "python": {
    "required": true,
    "minimum_version": "3.10",
    "observed_version": "3.11.15"
  },
  "workspace": {
    "integration_branch": "codex/vetted-saas-integration",
    "serial": true
  },
  "graph": {
    "required": true,
    "provider": "neon-postgres",
    "schema": "repository_intelligence_v1",
    "status_argv": [
      "npm",
      "run",
      "intelligence:sync"
    ],
    "sync_argv": [
      "npm",
      "run",
      "intelligence:sync:apply"
    ],
    "timeout_seconds": 900,
    "purpose": "document-authority-only"
  },
  "code_graph": {
    "provider": "codebase-memory-mcp",
    "version": "0.12.1",
    "status_argv": [
      "node",
      "scripts/code-intelligence/validate.ts"
    ],
    "sync_argv": [
      "node",
      "scripts/code-intelligence/update-local.ts"
    ],
    "publication": "reviewed-github-artifact-only"
  }
}
