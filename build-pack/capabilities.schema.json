{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalSetup capabilities v2",
  "type": "object",
  "required": ["schema_version", "python", "workspace", "graph"],
  "properties": {
    "schema_version": {"const": 2},
    "python": {"type": "object"},
    "workspace": {"type": "object", "required": ["integration_branch", "serial"]},
    "graph": {
      "oneOf": [
        {
          "type": "object",
          "required": ["required", "provider", "schema", "status_argv", "sync_argv"],
          "properties": {
            "required": {"const": true},
            "provider": {"const": "neon-postgres"},
            "schema": {"const": "repository_intelligence_v1"},
            "status_argv": {"type": "array", "minItems": 1},
            "sync_argv": {"type": "array", "minItems": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["required", "provider", "reason"],
          "properties": {
            "required": {"const": false},
            "provider": {"const": "disabled"},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
