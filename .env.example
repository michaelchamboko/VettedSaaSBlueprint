DATABASE_URL="oracle://user:password@oracle-autonomous-db-host/service_name"
ORACLE_CONNECTION_STRING=""         # Optional if DATABASE_URL is used
ORACLE_SERVICE_ALIAS=""            # Optional if DATABASE_URL does not include service and ORACLE_CONNECTION_STRING is not used
ORACLE_DB_USER=""                  # Optional if DATABASE_URL includes credentials
ORACLE_DB_PASSWORD=""              # Optional if DATABASE_URL includes credentials
ORACLE_WALLET_LOCATION="/secure/runtime/path/to/oracle-wallet"
TNS_ADMIN="/secure/runtime/path/to/oracle-wallet"
HERMES_API_TOKEN="replace-with-long-random-token"
ORACLE_SESSION_SECRET="replace-with-random-session-secret"
NEXT_PUBLIC_SITE_URL="https://vetted-saa-s-blueprint.vercel.app"
ORACLE_APP_USER="owner"            # Legacy fallback
ORACLE_APP_PASSWORD="replace-with-password" # Legacy fallback
